# じゃんけんゲーム
import random

print('じゃんけんゲーム')
print('0:グー')
print('1:チョキ')
print('2:パー')

hands = ['グー', 'チョキ', 'パー']
wins = 0
losses = 0
rounds = 0
max_rounds = 3

print('3回勝負')
while rounds < max_rounds:
    yourchoice = int(input('選んでください > '))
    if yourchoice not in [0, 1, 2]:
        print('0, 1, 2のいずれかを入力してください')
        continue

    computerchoice = random.randint(0, 2)
    print('コンピュータは' + hands[computerchoice] + 'を出しました')

    if yourchoice == computerchoice:
        print('あいこです。もう一度！')
        continue
    rounds += 1
    if (yourchoice == 0 and computerchoice == 1) or (yourchoice == 1 and computerchoice == 2) or (yourchoice == 2 and computerchoice == 0):
        wins += 1
        print('あなたの勝ちです')
    else:
        losses += 1
        print('あなたの負けです')

print(f'{wins}勝{losses}敗')