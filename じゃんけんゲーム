# じゃんけんゲーム
import random

print('じゃんけんゲーム')
print('0:グー')
print('1:チョキ')
print('2:パー')

hands = ['グー', 'チョキ', 'パー']

while True:
    yourchoice = int(input('選んでください > '))
    if yourchoice not in [0, 1, 2]:
        print('0, 1, 2のいずれかを入力してください')
        continue

    computerchoice = random.randint(0, 2)
    print('コンピュータは' + hands[computerchoice] + 'を出しました')

    if yourchoice == computerchoice:
        print('あいこです。もう一度！')
        continue
    elif (yourchoice == 0 and computerchoice == 1) or (yourchoice == 1 and computerchoice == 2) or (yourchoice == 2 and computerchoice == 0):
        print('あなたの勝ちです')
    else:
        print('あなたの負けです')
    break