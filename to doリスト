print('ToDoリスト')

tasks = []

while True:
    print('\n1 : タスク追加')
    print('2 : タスク表示')
    print('3 : タスク削除')
    print('4 : 終了')
    choice = input('選択してください> ')

    if choice == '1':
        task = input('追加するタスクを入力してください> ')
        tasks.append(task)
        print(f'{task} を追加しました')
    elif choice == '2':
        print('現在のタスク:')
        if len(tasks) == 0:
            print('タスクがありません')
        else:
            for i, task in enumerate(tasks, start=1):
                print(f'{i}. {task}')
    elif choice == '3':
        if len(tasks) == 0:
            print('削除できるタスクがありません')
            continue
        print('現在のタスク:')
        for i, task in enumerate(tasks, start=1):
            print(f'{i}. {task}')
        task_number = int(input('削除する番号を選んでください> '))
        if task_number < 1 or task_number > len(tasks):
            print('正しい番号を入力してください')
            continue
        removed = tasks.pop(task_number - 1)
        print(f'{removed} を削除しました')
    elif choice == '4':
        print('終了します')
        break
    else:
        print('1〜4の番号を入力してください')    