print('ToDoリスト')

tasks = []

while True:
    print('\n1 : タスク追加')
    print('2 : タスク表示')
    print('3 : タスク削除')
    print('4 : 完了にする')
    print('5 : 終了')
    choice = input('選択してください> ')

    if choice == '1':
        task = input('追加するタスクを入力してください> ')
        tasks.append({"task": task, "done": False})
        print(f'{task} を追加しました')
    elif choice == '2':
        print('現在のタスク:')
        if len(tasks) == 0:
            print('タスクがありません')
        else:
            for i, task in enumerate(tasks, start=1):
                status = "✓" if task["done"] else " "
                print(f'{i}. [{status}] {task["task"]}')
    elif choice == '3':
        if len(tasks) == 0:
            print('削除できるタスクがありません')
            continue
        print('現在のタスク:')
        for i, task in enumerate(tasks, start=1):
            status = "✓" if task["done"] else " "
            print(f'{i}. [{status}] {task["task"]}')
        try:      
            task_number = int(input('削除する番号を選んでください> '))
        except ValueError:
            print('数字を入力してください')
            continue
        if task_number < 1 or task_number > len(tasks):
            print('正しい番号を入力してください')
            continue
        removed = tasks.pop(task_number - 1)
        print(f'{removed} を削除しました')
    elif choice == '4':
        if len(tasks) == 0:
            print('完了にできるタスクがありません')
            continue
        print('現在のタスク:')
        for i, task in enumerate(tasks, start=1):
            print(f'{i}. {task}') 
        try:      
            task_number = int(input('完了にする番号を選んでください> '))
        except ValueError:
            print('数字を入力してください')
            continue
        if task_number < 1 or task_number > len(tasks):
            print('正しい番号を入力してください')
            continue
        tasks[task_number - 1]["done"] = True
        print('タスクを完了にしました')
        for i, task in enumerate(tasks, start=1):
            status = "✓" if task["done"] else " "
            print(f'{i}. [{status}] {task["task"]}')       
    elif choice == '5':
        print('終了します')
        break   